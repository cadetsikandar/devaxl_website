# Contact form delivery (Web3Forms).
# 1. Go to https://web3forms.com and create an access key using touqeerhassan76@gmail.com
#    as the inbox — submissions are delivered to whichever email you register.
# 2. Set this in Vercel: Project → Settings → Environment Variables (and in .env.local for dev).
WEB3FORMS_KEY=your-web3forms-access-key

# Plausible analytics. Set this to the domain you added in Plausible (no
# protocol, no trailing slash) — the script and all custom events are skipped
# entirely when it's unset, so local dev and preview deploys stay out of the
# numbers. Set it in Vercel for Production only.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=devaxl.com
